MOCK_MODE=true
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=VinSmartFuture
MONGODB_USER_PROFILE_COLLECTION=Users
MONGODB_BOOKINGS_COLLECTION=Booking
# Optional. Copy values from your DBeaver local PostgreSQL connection.
# Used only when options.enrich_postgres_candidates=true.
# PostgreSQL enriches existing candidate IDs; it does not add new candidates.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Examples:
# POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/VinSmartFuture
# POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:5432/hotels_db
POSTGRES_DSN=
HOTEL_API_BASE_URL=
HOTEL_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=0
