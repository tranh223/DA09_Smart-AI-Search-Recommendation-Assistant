
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=VinSmartFuture


NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password


OPENAI_API_KEY=sk-...
BASE_URL=https://api.openai.com/v1

KAFKA_URL=localhost:9092

# Qdrant vector store (BGE-M3 embeddings)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_TAGS=hotel_tags
QDRANT_COLLECTION_HOTELS=hotels

# Embedding model (HuggingFace)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32

# BM25 keyword index (build via scripts/build_qdrant_embeddings.py)
BM25_INDEX_PATH=../data/embeddings/hotel_bm25.pkl
