
OPENAI_API_KEY=sk-...
# Responses API endpoint — used by Query Understanding and final Response Builder
OPENAI_RESPONSES_BASE_URL=https://api.openai.com/v1/responses
# Backward-compatible alias for old code/configs that expected Responses API here
OPENAI_BASE_URL=https://api.openai.com/v1/responses
# Chat Completions base URL — used by RAG, summarizer, reranker, evaluator
OPENAI_CHAT_BASE_URL=https://api.openai.com/v1
BASE_URL=https://api.openai.com/v1

# One OpenAI model used by all LLM calls in the backend
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY_SECONDS=1.0

# Final response synthesis runtime controls
RESPONSE_BUILDER_TIMEOUT_SECONDS=25
RESPONSE_BUILDER_MAX_RETRIES=1

# Memory summarizer runtime controls
SUMMARY_LLM_TEMPERATURE=0.3
SUMMARY_LLM_TIMEOUT_SECONDS=30

# RAG generation runtime controls
RAG_LLM_TEMPERATURE=0.7
RAG_LLM_MAX_TOKENS=2000
RAG_LLM_TIMEOUT_SECONDS=30


MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=VinSmartFuture
MONGODB_USER_PROFILE_COLLECTION=Users
MONGODB_BOOKINGS_COLLECTION=Booking

MONGO_TLS_ALLOW_INVALID=false

NEO4J_URI=bolt://<host>:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<password>
NEO4J_DATABASE=neo4j
NEO4J_MAX_RETRIES=3

# Neo4j HTTP API — dùng bởi RAG graph_tool.py (port 7474, khác Bolt 7687)
# Nếu không set, code tự derive từ NEO4J_URI
GRAPH_DB_URL=http://<host>:7474


QDRANT_URL=http://localhost:6333
VECTOR_DB_URL=localhost:6333

# API key — chỉ cần khi dùng Qdrant Cloud  [TÙY CHỌN]
QDRANT_API_KEY=
QDRANT_COLLECTION_TAGS=hotel_tags
QDRANT_COLLECTION_HOTELS=hotels


EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32

# HuggingFace token — tăng rate limit download model từ HF Hub [TÙY CHỌN]
# Lấy token tại: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_huggingface_token_here

# BM25 index path — build bằng scripts/build_qdrant_embeddings.py  [TÙY CHỌN]
BM25_INDEX_PATH=../data/embeddings/hotel_bm25.pkl


# QUERY UNDERSTANDING — Semantic Tag Mapping [TÙY CHỌN]
# Đường dẫn đến FAISS index và metadata cho semantic tag mapping
# Để trống để sử dụng default path: ../data/vector_db/
QU_TAG_INDEX_PATH=
QU_TAG_METADATA_PATH=

# QUERY UNDERSTANDING — Prompt Caching [TÙY CHỌN]
# Chỉ các prompt đủ dài mới bật caching. Mặc định threshold = 1024 tokens ước lượng.
LLM_PROMPT_CACHE_ENABLED=true
LLM_PROMPT_CACHE_MIN_TOKENS=1024
LLM_PROMPT_CACHE_RETENTION=in_memory


KAFKA_URL=localhost:9092

HOTEL_API_BASE_URL=https://supabase-ota-travel.onrender.com
HOTEL_API_KEY=<your_hotel_api_key>

DA10_API_BASE_URL=https://supabase-ota-travel.onrender.com
DA10_OTA_API_KEY=<your_hotel_api_key>
OTA_API_KEY=<your_hotel_api_key>

# LLM reranker runtime controls
RERANK_TEMPERATURE=0.1

POSTGRES_DSN=


# -----------------------------------------------------------------------------
# 11. LANGSMITH — Tracing  [TÙY CHỌN]
#     Dùng bởi: RAG module (trace pipeline steps)
# -----------------------------------------------------------------------------
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=DA09
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

LOG_LEVEL=INFO

# MOCK_MODE=true — bỏ qua kết nối DB thật, dùng stub data (chỉ cho dev)
MOCK_MODE=false


# -----------------------------------------------------------------------------
# API GATEWAY (main.py)
# -----------------------------------------------------------------------------

# production | staging | development
# Khi ENVIRONMENT=production: /docs và /redoc bị ẩn, test endpoints bị tắt
ENVIRONMENT=development

# Danh sách origin được phép gọi API (ngăn cách bằng dấu phẩy)
# PRODUCTION: thay "*" bằng domain thật, e.g. https://app.example.com
# DEVELOPMENT: để trống để dùng "*"
CORS_ORIGINS=*

# Bật/tắt /test/* endpoints (mặc định: true khi development, false khi production)
ENABLE_TEST_ENDPOINTS=true

# Timeout tối đa cho mỗi request chat (giây)
CHAT_TIMEOUT_SECONDS=180
