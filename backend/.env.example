OPENAI_API_KEY=
BASE_URL=https://api.openai.com/v1

MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?appName=<app>
DATABASE_NAME=VinSmartFuture
MONGODB_USER_PROFILE_COLLECTION=Users
MONGODB_BOOKINGS_COLLECTION=Booking

MONGO_TLS_ALLOW_INVALID=false

NEO4J_URI=bolt://<host>:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_MAX_RETRIES=3

# Neo4j HTTP API — dùng bởi RAG graph_tool.py (port 7474, khác Bolt 7687)
GRAPH_DB_URL=http://<host>:7474

KAFKA_URL=<host>:9094

HOTEL_API_BASE_URL=https://supabase-ota-travel.onrender.com
HOTEL_API_KEY=

DA10_OTA_API_KEY=
OTA_API_KEY=

POSTGRES_DSN=postgresql://<user>:<password>@<host>:5432/postgres

# -----------------------------------------------------------------------------
# LANGSMITH — Tracing  [TÙY CHỌN]
# -----------------------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=DA09
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

LOG_LEVEL=INFO

# MOCK_MODE=true — bỏ qua kết nối DB thật, dùng stub data (chỉ cho dev)
MOCK_MODE=false

# -----------------------------------------------------------------------------
# API GATEWAY (main.py)
# -----------------------------------------------------------------------------

# production | staging | development
# Khi ENVIRONMENT=production: /docs và /redoc bị ẩn, test endpoints bị tắt
ENVIRONMENT=development

# Danh sách origin được phép gọi API (ngăn cách bằng dấu phẩy)
# PRODUCTION: thay "*" bằng domain thật, e.g. https://app.example.com
# DEVELOPMENT: để trống để dùng "*"
CORS_ORIGINS=*

# Bật/tắt /test/* endpoints (mặc định: true khi development, false khi production)
ENABLE_TEST_ENDPOINTS=true

# Timeout tối đa cho mỗi request chat (giây)
CHAT_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# LLM runtime controls
# -----------------------------------------------------------------------------
# One OpenAI model used by all LLM calls in the backend
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY_SECONDS=1.0

# Final response synthesis runtime controls
RESPONSE_BUILDER_TIMEOUT_SECONDS=25
RESPONSE_BUILDER_MAX_RETRIES=1

# Memory summarizer runtime controls
SUMMARY_LLM_TEMPERATURE=0.3
SUMMARY_LLM_TIMEOUT_SECONDS=30

# RAG generation runtime controls
RAG_LLM_TEMPERATURE=0.9
RAG_LLM_MAX_TOKENS=12000
RAG_LLM_TIMEOUT_SECONDS=30

# Streaming typing-effect delay between word chunks (seconds)
# Tăng để chậm hơn, giảm/bằng 0 để tắt delay
STREAM_WORD_DELAY_SECONDS=0.018

# Hidden intent extractor runtime controls
HIDDEN_INTENT_ENABLED=true
HIDDEN_INTENT_MODEL=gpt-5.4-mini
HIDDEN_INTENT_TEMPERATURE=0.1
HIDDEN_INTENT_MIN_CONFIDENCE=0.65
HIDDEN_INTENT_PROFILE_TOP_N=5
HIDDEN_INTENT_TIMEOUT_SECONDS=15
