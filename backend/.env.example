# OTA Smart AI - environment template
# Copy this file to .env

# OpenAI
OPENAI_API_KEY=

# Neo4j
NEO4J_URI=
NEO4J_PASSWORD=

# Mongo
MONGO_URI=

# -------- Supabase (used for crawling hotel table / optional) --------
SUPABASE_URL=https://srxvcctocmbczodvppqc.supabase.co
SUPABASE_KEY=sb_publishable_DbIyixYRk5jf5dIBwQuXLg_oZCJIPME
# Optional extra keys (may not be required depending on RLS)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://srxvcctocmbczodvppqc.supabase.co/auth/v1/.well-known/jwks.json

# Which Supabase table to crawl
SUPABASE_TABLE=hotel

# Crawling controls
SUPABASE_PAGE_SIZE=1000
SUPABASE_SLEEP_S=0.2

# -------- Qdrant (Vector DB for hotels) --------
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=hotels
QDRANT_DISTANCE=cosine

